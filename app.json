{
  "expo": {
    "name": "Storm Chaser",
    "slug": "storm-chaser-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stormchaser",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.stormchaser.assessment"
    },
    "android": {
      "package": "com.stormchaser.assessment",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "app"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Storm Chaser to use the camera to document storms.",
          "photosPermission": "Allow Storm Chaser to access photos used for storm documentation.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Storm Chaser to use your location for local weather and storm coordinates."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
